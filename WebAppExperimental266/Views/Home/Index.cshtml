@model IEnumerable<WebAppExperimental266.Models.Main_Objects.CrudRecord>
@{
    ViewData["Title"] = "Public Card Dumps";
}

<div class="upload-page">
    <div class="upload-card mb-4">
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="h3 mb-1">Public Card Dumps</h1>
                <p class="text-muted mb-0">Browse public uploads from signed-in users.</p>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="btn btn-primary" asp-controller="Records" asp-action="Create">+ New Upload</a>
            }
            else
            {
                <a class="btn btn-outline-primary" asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignIn">Sign in to upload</a>
            }
        </div>
    </div>

    <div class="upload-card">
        @if (!Model.Any())
        {
            <p class="text-muted mb-0">No public uploads yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Owner</th>
                            <th>Updated</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td><span class="badge text-bg-light border">@item.CardType</span></td>
                                <td>@item.OwnerDisplayName</td>
                                <td>@item.UpdatedUtc.ToString("u")</td>
                                <td class="text-end">
                                    @if (!string.IsNullOrWhiteSpace(item.UploadedFileName))
                                    {
                                        <a asp-controller="Records" asp-action="Download" asp-route-id="@item.Id">Download</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
