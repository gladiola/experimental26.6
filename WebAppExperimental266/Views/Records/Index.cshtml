@model IEnumerable<WebAppExperimental266.Models.Main_Objects.CrudRecord>

@{
    ViewData["Title"] = "My Records";
}

<h1>My Records</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Upload</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Updated</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Title</td>
            <td>@item.UpdatedUtc.ToString("u")</td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
