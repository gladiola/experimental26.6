@model WebAppExperimental266.Models.Main_Objects.CrudRecord

@{
    ViewData["Title"] = "Record Details";
}

<h1>Record Details</h1>

<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Description</dd>

    <dt class="col-sm-2">Created</dt>
    <dd class="col-sm-10">@Model.CreatedUtc.ToString("u")</dd>

    <dt class="col-sm-2">Updated</dt>
    <dd class="col-sm-10">@Model.UpdatedUtc.ToString("u")</dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>
